# ---- Server --------------------------------------------------------------
# For production HTTPS behind a reverse proxy, set this to 1.
EDA_COOKIE_SECURE=0
# Optional: choose a persistent disk location.
# EDA_DB_PATH=./data/executive_desk.db

# ---- Hosted PostgreSQL (required on Vercel) ------------------------------
# Local runs keep using SQLite. A serverless host has no persistent disk, so
# set this to a PostgreSQL URL (Neon, Supabase, Vercel Postgres). Use the
# "-pooler" host when the provider offers one — every request opens a
# connection. Leave blank to keep SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Reminder cron (required on Vercel) ----------------------------------
# Vercel freezes the app between requests, so the built-in scheduler is
# replaced by an external call to /api/cron/reminders. Any non-guessable
# string works; send it as "Authorization: Bearer <value>".
# CRON_SECRET=

# ---- Google Sign-In + Google Calendar ------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials
# Then add this Authorised redirect URI:
#   http://localhost:8000/api/auth/google/callback
# Enable the "Google Calendar API" for the project. Leave both blank to keep
# email/password sign-in only; the Google button then shows "not configured".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit redirect (must match the console exactly). Defaults to
# <request origin>/api/auth/google/callback
# GOOGLE_REDIRECT_URI=https://desk.example.com/api/auth/google/callback

# ---- Web Push (background notifications) ---------------------------------
# Leave blank to auto-generate VAPID keys on first run (stored in data/vapid.json).
# On Vercel all three are REQUIRED: the filesystem cannot keep the generated
# keys, and a different key per instance would invalidate every subscription.
# Generate a pair locally with:  python -m py_vapid
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- WhatsApp reminders (official WhatsApp Business Cloud API) -----------
# Every reminder (tasks, meetings, tentative events, follow-ups) is also sent
# to WhatsApp using the same lead times as Web Push. Create a Meta app with the
# WhatsApp product at https://developers.facebook.com/apps, then copy:
#   WHATSAPP_TOKEN            permanent access token for your Meta app
#   WHATSAPP_PHONE_NUMBER_ID  the business sender's phone number id
# Business-initiated messages must use a template APPROVED in Meta Business
# Manager. The default name below expects a template with two body variables
# (first the heading, then the reminder details). Leave blank to keep WhatsApp
# switched off; the settings screen then shows "Not configured" and nothing is
# sent or faked.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional overrides (defaults shown):
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_NAME=executive_desk_reminder
# WHATSAPP_TEMPLATE_LANG=en
# Testing only: send free-form text instead of a template. Works only inside an
# open 24-hour customer-service session; leave unset in production.
# WHATSAPP_TEXT_MODE=1
